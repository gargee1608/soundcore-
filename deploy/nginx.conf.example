# Example nginx site. Install certificates yourself, then:
#   sudo ln -s /opt/soundcore/deploy/nginx.conf.example /etc/nginx/sites-available/soundcore
# Flask must stay bound to 127.0.0.1. Do not publish port 8741.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name soundcore.local;

    ssl_certificate     /etc/soundcore/tls/fullchain.pem;
    ssl_certificate_key /etc/soundcore/tls/privkey.pem;

    client_max_body_size 512m;

    location / {
        proxy_pass http://127.0.0.1:8741;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
