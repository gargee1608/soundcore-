# Copy to /etc/soundcore/soundcore.env on a Pi, or to .env for local development.
# Environment variables override config/soundcore.json. Do not commit real secrets.

# Required for the admin account. Used only when that user does not exist yet
# (or when SOUNDCORE_RESET_ADMIN=1). There is no built-in password.
SOUNDCORE_ADMIN_EMAIL=admin@localhost
SOUNDCORE_ADMIN_PASSWORD=

# Generated and stored under the data directory if left empty.
SOUNDCORE_SECRET_KEY=

# sqlite by default. Postgres later: postgresql+psycopg://user:pass@localhost/soundcore
SOUNDCORE_DATABASE_URL=
SOUNDCORE_DATA_DIR=data

# Web process. Keep this on localhost; Caddy or nginx owns HTTPS.
SOUNDCORE_HOST=127.0.0.1
SOUNDCORE_PORT=8741
SOUNDCORE_BEHIND_PROXY=0
SOUNDCORE_COOKIE_SECURE=0

# auto | simulated | alsa
# auto uses ALSA when capture devices exist, otherwise the simulated desk.
SOUNDCORE_AUDIO_BACKEND=auto
# 1 runs capture inside the web process. Set 0 when using soundcore-worker.service.
SOUNDCORE_EMBED_WORKER=1
# 1 enables the first three simulated/discovered inputs on a brand-new database.
SOUNDCORE_SEED_DEMO=0

# Midnight offload uses this IANA zone. Empty means the Pi's local zone.
SOUNDCORE_TIMEZONE=
SOUNDCORE_STREAM_CAP=8
SOUNDCORE_WARN_RATIO=0.8
SOUNDCORE_CHUNK_SECONDS=45
SOUNDCORE_SAMPLE_RATE=16000
SOUNDCORE_IDLE_DAYS=7
SOUNDCORE_FREE_RESERVE=0.05
SOUNDCORE_CLEANUP_USED=0.95

# S3. Leave blank to keep files local and skip offload.
SOUNDCORE_S3_BUCKET=
SOUNDCORE_S3_PREFIX=soundcore
SOUNDCORE_S3_REGION=us-east-1
SOUNDCORE_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SOUNDCORE_S3_PRESIGN_SECONDS=3600

# Boondock transcription v3. The key is the per-customer X-Boondock-Key.
SOUNDCORE_BOONDOCK_BASE_URL=https://api.boondock.cloud
SOUNDCORE_BOONDOCK_API_KEY=
SOUNDCORE_BOONDOCK_TIMEOUT=60
SOUNDCORE_BOONDOCK_LANGUAGE=
SOUNDCORE_BOONDOCK_MODEL=
SOUNDCORE_TRANSCRIBE_ENABLED=
SOUNDCORE_TRANSCRIBE_MAX_BYTES=2097152
SOUNDCORE_TRANSCRIBE_MAX_ATTEMPTS=5

# Notifications. Dashboard and the log always record alerts.
# Email is sent only when SMTP host, from-address, and notify email are set.
SOUNDCORE_SMTP_HOST=
SOUNDCORE_SMTP_PORT=587
SOUNDCORE_SMTP_USER=
SOUNDCORE_SMTP_PASSWORD=
SOUNDCORE_SMTP_FROM=
SOUNDCORE_SMTP_TLS=1
SOUNDCORE_NOTIFY_EMAIL=
SOUNDCORE_NOTIFY_WEBHOOK=

# Local UDP hop between the worker and the web process.
SOUNDCORE_LIVE_HOST=127.0.0.1
SOUNDCORE_LIVE_PORT=8742
SOUNDCORE_GUARD_INTERVAL=60
